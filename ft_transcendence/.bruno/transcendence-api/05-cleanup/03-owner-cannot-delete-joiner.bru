meta {
  name: Owner cannot delete joiner account
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/users/{{joinerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

tests {
  test("deleting another user returns 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
