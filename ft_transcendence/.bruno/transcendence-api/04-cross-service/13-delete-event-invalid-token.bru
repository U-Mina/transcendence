meta {
  name: Delete event with invalid token
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/events/{{eventId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{invalidToken}}
}

tests {
  test("invalid token cannot delete event — 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
