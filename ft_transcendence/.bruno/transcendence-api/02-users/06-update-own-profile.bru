meta {
  name: Update own profile
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/users/{{ownerId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{ownerToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userName": "{{ownerUserName}}_updated",
    "userContact": "+49123456789"
  }
}

tests {
  test("update own profile returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("userContact updated", function () {
    expect(res.getBody().userContact).to.equal("+49123456789");
  });
}
