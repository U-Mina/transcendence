meta {
  name: List users without token
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: none
}

tests {
  test("missing token returns 401", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("error mentions invalid or expired token", function () {
    expect(res.getBody().error).to.equal("Invalid or expired access token.");
  });
}
