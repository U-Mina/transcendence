meta {
  name: Login wrong password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "WrongPassword999!"
  }
}

tests {
  test("wrong password returns 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
