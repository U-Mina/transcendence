meta {
  name: Login unknown email
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nobody_exists_here@example.com",
    "password": "{{password}}"
  }
}

tests {
  test("unknown email returns 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
