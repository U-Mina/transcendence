meta {
  name: Register short password
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userName": "too_short_pw",
    "email": "shortpw_{{ownerUserName}}@example.com",
    "password": "short"
  }
}

tests {
  test("short password returns 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
