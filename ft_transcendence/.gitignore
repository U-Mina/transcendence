
__DS_Store
.DS_Store

# --- Dependencies (Never commit these) ---
node_modules/
.pnpm-store/

# --- Environment Variables (Keep sensitive data private) ---
.env
.env.*
!.env.example

# --- Build and Log Files ---
dist/
build/
*.log
*.sqlite3
*.sqlite3-journal

# --- IDE and Editor Files ---
.vscode/
.idea/
.DS_Store

# --- Prisma (Keep migration files, ignore auto-generated client) ---
# Migration files must be committed, but the generated client should not
node_modules/@prisma/client/

services/user-service/prisma/migrations/*
services/event-service/prisma/migrations/*

