API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
EVENT_SERVICE_PORT=3002
FRONTEND_PORT=8080

USER_SERVICE_URL=https://user-service:3001
EVENT_SERVICE_URL=https://event-service:3002

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=transcendence
MYSQL_USER=transcendence_user
MYSQL_PASSWORD=change-me-user-password

DB_HOST=database
DB_PORT=3306
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}
DB_NAME=${MYSQL_DATABASE}

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=transcendence-api-gateway
JWT_AUDIENCE=transcendence-frontend
JWT_EXPIRES_IN=1h
UPLOAD_DIR=/app/uploads

# Shared secret for gateway ↔ service and service ↔ service calls
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-internal-token

# Public API key for /api/v1/public/* (send as header X-API-Key). Rate limit: 100 req/min.
PUBLIC_API_KEY=change-me-to-a-long-random-public-api-key

GF_ADMIN=example
GF_PASSWORD=example

PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
ALERTMANAGER_PORT=9093

MYSQL_EXPORTER_USER=mysqld_exporter
MYSQL_EXPORTER_PASSWORD=replace_with_a_strong_password
MYSQL_EXPORTER_PORT=9104
# Automated backups (db-backup service). Default: once per day, keep 7 days.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
