APP_NAME=transcendence

# Backend
NODE_ENV=production
PORT=3000

# Database connection used by the backend service
DATABASE_URL=mysql://app_user:change_me_db_password@db:3306/transcendence
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USER=app_user
DATABASE_PASSWORD=change_me_db_password
DATABASE_NAME=transcendence

# Frontend
FRONTEND_PORT=8080


# Database container
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_db_password
MYSQL_DATABASE=transcendence
MYSQL_PORT=3306
